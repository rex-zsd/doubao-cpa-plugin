diff --git a/internal/pluginhost/http_public_network.go b/internal/pluginhost/http_public_network.go
new file mode 100644
index 0000000..06495f0
--- /dev/null
+++ b/internal/pluginhost/http_public_network.go
@@ -0,0 +1,112 @@
+package pluginhost
+
+import (
+	"context"
+	"crypto/tls"
+	"fmt"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/proxyutil"
+	"net"
+	"net/http"
+	"net/netip"
+	"strings"
+)
+
+// publicNetworkClient resolves at dial time and dials the checked address. A DNS
+// preflight alone is insufficient because resolution can change between calls.
+func publicNetworkClient(req *http.Request, proxyURL string) (*http.Client, func(), error) {
+	return publicNetworkClientWithResolver(req, proxyURL, net.DefaultResolver.LookupNetIP)
+}
+func publicNetworkClientWithResolver(req *http.Request, proxyURL string, resolve func(context.Context, string, string) ([]netip.Addr, error)) (*http.Client, func(), error) {
+	if req.URL.Scheme != "https" || req.URL.Port() != "" && req.URL.Port() != "443" || req.URL.User != nil {
+		return nil, nil, fmt.Errorf("public-network profile requires HTTPS port 443")
+	}
+	hostname := req.URL.Hostname()
+	addresses, err := resolve(req.Context(), "ip", hostname)
+	if err != nil || len(addresses) == 0 {
+		return nil, nil, fmt.Errorf("public-network address resolution failed")
+	}
+	for _, ip := range addresses {
+		if !publicNetworkIP(ip) {
+			return nil, nil, fmt.Errorf("public-network profile rejected a non-public address")
+		}
+	}
+	chosen := addresses[0].Unmap()
+	for _, ip := range addresses {
+		if ip.Unmap().Is4() {
+			chosen = ip.Unmap()
+			break
+		}
+	}
+	if strings.TrimSpace(proxyURL) == "" {
+		proxy, err := http.ProxyFromEnvironment(req)
+		if err != nil {
+			return nil, nil, err
+		}
+		if proxy != nil {
+			proxyURL = proxy.String()
+		} else {
+			proxyURL = "direct"
+		}
+	}
+	transport, _, err := proxyutil.BuildHTTPTransport(proxyURL)
+	if err != nil {
+		return nil, nil, err
+	}
+	if transport == nil {
+		transport = proxyutil.NewDirectTransport()
+	}
+	if transport.TLSClientConfig == nil {
+		transport.TLSClientConfig = &tls.Config{}
+	} else {
+		transport.TLSClientConfig = transport.TLSClientConfig.Clone()
+	}
+	transport.TLSClientConfig.ServerName = hostname
+	// A proxy must CONNECT to the checked IP, never resolve the original hostname.
+	// Preserve HTTP Host and TLS SNI/certificate identity independently of routing.
+	originalHost := req.URL.Host
+	copiedURL := *req.URL
+	copiedURL.Host = net.JoinHostPort(chosen.String(), "443")
+	req.URL = &copiedURL
+	req.Host = originalHost
+	return &http.Client{Transport: transport}, transport.CloseIdleConnections, nil
+}
+func publicNetworkDial(ctx context.Context, network, address string) (net.Conn, error) {
+	host, port, err := net.SplitHostPort(address)
+	if err != nil {
+		return nil, err
+	}
+	addresses, err := net.DefaultResolver.LookupNetIP(ctx, "ip", host)
+	if err != nil {
+		return nil, err
+	}
+	if len(addresses) == 0 {
+		return nil, fmt.Errorf("public-network address is unavailable")
+	}
+	for _, ip := range addresses {
+		if !publicNetworkIP(ip) {
+			return nil, fmt.Errorf("public-network profile rejected a non-public address")
+		}
+	}
+	var last error
+	for _, ip := range addresses {
+		conn, err := (&net.Dialer{}).DialContext(ctx, network, net.JoinHostPort(ip.String(), port))
+		if err == nil {
+			return conn, nil
+		}
+		last = err
+	}
+	return nil, last
+}
+func publicNetworkIP(ip netip.Addr) bool {
+	ip = ip.Unmap()
+	if !ip.IsGlobalUnicast() || ip.IsPrivate() || ip.IsLoopback() || ip.IsLinkLocalUnicast() {
+		return false
+	}
+	ranges := []string{"0.0.0.0/8", "100.64.0.0/10", "169.254.0.0/16", "192.0.0.0/24", "192.0.2.0/24", "198.18.0.0/15", "198.51.100.0/24", "203.0.113.0/24", "240.0.0.0/4", "::/96", "64:ff9b::/96", "64:ff9b:1::/48", "100::/64", "2001::/23", "2001:db8::/32", "2002::/16"}
+	for _, value := range ranges {
+		if netip.MustParsePrefix(value).Contains(ip) {
+			return false
+		}
+	}
+	return ip.Is4() || netip.MustParsePrefix("2000::/3").Contains(ip)
+}
diff --git a/internal/pluginhost/http_public_network_test.go b/internal/pluginhost/http_public_network_test.go
new file mode 100644
index 0000000..52a2003
--- /dev/null
+++ b/internal/pluginhost/http_public_network_test.go
@@ -0,0 +1,51 @@
+package pluginhost
+
+import (
+	"context"
+	"net/http"
+	"net/netip"
+	"testing"
+)
+
+func TestPublicNetworkAddressGuard(t *testing.T) {
+	for _, value := range []string{"127.0.0.1", "10.0.0.1", "100.100.100.200", "169.254.169.254", "192.168.1.1", "0.0.0.0", "198.18.0.1", "192.0.2.1", "224.0.0.1", "::1", "::ffff:127.0.0.1", "64:ff9b::7f00:1", "fc00::1", "fe80::1", "2002:7f00:1::1", "2001:db8::1"} {
+		if publicNetworkIP(netip.MustParseAddr(value)) {
+			t.Errorf("allowed %s", value)
+		}
+	}
+	for _, value := range []string{"1.1.1.1", "8.8.8.8", "2606:4700:4700::1111"} {
+		if !publicNetworkIP(netip.MustParseAddr(value)) {
+			t.Errorf("rejected %s", value)
+		}
+	}
+	if conn, err := publicNetworkDial(context.Background(), "tcp", "127.0.0.1:443"); err == nil {
+		conn.Close()
+		t.Fatal("local address dialed")
+	}
+}
+func TestPublicNetworkProfileRejectsUnsafeFraming(t *testing.T) {
+	for _, endpoint := range []string{"http://example.com", "https://example.com:123", "https://u:p@example.com"} {
+		req, _ := http.NewRequest("GET", endpoint, nil)
+		if _, _, err := publicNetworkClient(req, "direct://"); err == nil {
+			t.Error(endpoint)
+		}
+	}
+	req, _ := http.NewRequest("GET", "https://source.example/a", nil)
+	client, cleanup, err := publicNetworkClientWithResolver(req, "http://proxy.invalid:8080", func(context.Context, string, string) ([]netip.Addr, error) {
+		return []netip.Addr{netip.MustParseAddr("8.8.8.8")}, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer cleanup()
+	if req.URL.Host != "8.8.8.8:443" || req.Host != "source.example" || client.Transport.(*http.Transport).TLSClientConfig.ServerName != "source.example" {
+		t.Fatal("proxy target wasn't pinned with original TLS identity")
+	}
+	req, _ = http.NewRequest("GET", "https://source.example/a", nil)
+	_, _, err = publicNetworkClientWithResolver(req, "direct", func(context.Context, string, string) ([]netip.Addr, error) {
+		return []netip.Addr{netip.MustParseAddr("8.8.8.8"), netip.MustParseAddr("127.0.0.1")}, nil
+	})
+	if err == nil {
+		t.Fatal("mixed private DNS answer accepted")
+	}
+}
diff --git a/internal/pluginhost/http_redirect_test.go b/internal/pluginhost/http_redirect_test.go
new file mode 100644
index 0000000..b557b55
--- /dev/null
+++ b/internal/pluginhost/http_redirect_test.go
@@ -0,0 +1,34 @@
+package pluginhost
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+func TestPluginHTTPBridgeDisableRedirects(t *testing.T) {
+	var called atomic.Int32
+	target := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { called.Add(1) }))
+	defer target.Close()
+	source := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		http.Redirect(w, r, target.URL, http.StatusTemporaryRedirect)
+	}))
+	defer source.Close()
+	host := &Host{}
+	client := host.newHTTPClient(nil)
+	response, err := client.Do(context.Background(), pluginapi.HTTPRequest{Method: "POST", URL: source.URL, Headers: http.Header{"Authorization": {"synthetic-token"}}, WireProfile: &pluginapi.HTTPWireProfile{DisableRedirects: true}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if response.StatusCode != 307 || called.Load() != 0 {
+		t.Fatal("redirect followed", response.StatusCode, called.Load())
+	}
+	response, err = client.Do(context.Background(), pluginapi.HTTPRequest{URL: source.URL})
+	if err != nil || response.StatusCode != 200 || called.Load() != 1 {
+		t.Fatal("default behavior changed", err, called.Load())
+	}
+}
